      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', function () { pm.expect(pm.response.code).to.eql(200); });",
              "const match = pm.response.text().match(/name=\"versao\" value=\"(\\d+)\"/);",
              "pm.test('Versao no formulario', function () { pm.expect(match).not.to.eql(null); });",
              "if (match) pm.collectionVariables.set('aluno_version', match[1]);"
            ]
          }
        }
      ]
