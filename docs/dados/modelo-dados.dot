digraph EduFast {
 graph [rankdir=LR, fontname="Helvetica", splines=true, nodesep=0.25, ranksep=0.9, pad=0.3];
 node [shape=plain, fontname="Helvetica", fontsize=10];
 edge [color="#64748b", arrowhead=crow, arrowtail=tee, dir=both];
 subgraph cluster_0 { label="Identidade e acesso"; fontsize=13; color="#0e7490"; fontcolor="#0e7490"; style=rounded;
  "usuarios" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#0e7490" colspan="2"><font color="white"><b>usuarios</b></font></td></tr><tr><td align="left">id</td><td align="left"><font color="#64748b">PK</font></td></tr><tr><td align="left" colspan="2"><font color="#94a3b8">+ 6 colunas</font></td></tr></table>>];
