  "professores" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#0e7490" colspan="2"><font color="white"><b>professores</b></font></td></tr><tr><td align="left">id</td><td align="left"><font color="#64748b">PK</font></td></tr><tr><td align="left">usuario_id</td><td align="left"><font color="#64748b">FK</font></td></tr><tr><td align="left" colspan="2"><font color="#94a3b8">+ 10 colunas</font></td></tr></table>>];
  "limites_login" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#0e7490" colspan="2"><font color="white"><b>limites_login</b></font></td></tr><tr><td align="left">chave</td><td align="left"><font color="#64748b">PK</font></td></tr><tr><td align="left" colspan="2"><font color="#94a3b8">+ 2 colunas</font></td></tr></table>>];
  "idempotencias" [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="3"><tr><td bgcolor="#0e7490" colspan="2"><font color="white"><b>idempotencias</b></font></td></tr><tr><td align="left">id</td><td align="left"><font color="#64748b">PK</font></td></tr><tr><td align="left" colspan="2"><font color="#94a3b8">+ 6 colunas</font></td></tr></table>>];
